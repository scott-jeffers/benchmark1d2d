          "units": "%"
        },
        "gating": true,
        "rationale": "Nodal peak pressure within 1 % of EPANET 2.2 at every node."
      },
      {
        "id": "link_volume",
        "metric": "relative_volume",
        "variable": "Q",
        "threshold": {
          "op": "abs<=",
          "value": 1.0,
          "units": "%"
        },
        "gating": true,
        "rationale": "24 h conveyed volume within 1 % of EPANET 2.2 in every pipe and pump."
      },
      {
        "id": "peak_timing",
        "metric": "timing_error",
        "variable": "Q",
        "threshold": {
          "op": "abs<=",
          "value": 3600,
          "units": "s"
        },
        "gating": false,
        "rationale": "Informational: one reporting step."
      }
    ]
  }

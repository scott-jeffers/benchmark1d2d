  },
  "simulation": {
    "t_end": 86400,
    "output_interval": 3600,
    "required_outputs": [
      "p",
      "Q"
    ]
  },
  "scoring": {
    "pass_rule": "all_gating",
    "criteria": [
      {
        "id": "peak_pressure",
        "metric": "relative_peak",
        "variable": "p",
        "threshold": {
          "op": "abs<=",

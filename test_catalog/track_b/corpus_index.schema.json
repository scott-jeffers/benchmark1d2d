    "model_id": {
      "type": "str",
      "description": "collection/case in the upstream corpus"
    },
    "collection": {
      "type": "str",
      "description": ""
    },
    "title": {
      "type": "str",
      "description": ""
    },
    "hash": {
      "type": "str",
      "description": "SHA-256 of model.inp at the pinned commit"
    },
    "tags": {
      "type": "object",
      "description": "HydroCouple tags (controlled vocabulary)"
    },
    "units": {
      "type": "str",
      "description": ""
    },
    "routing": {
      "type": "str",
      "description": ""
    },
    "size_class": {
      "type": "str",
      "description": ""
    },
    "upstream_runtime_class": {
      "type": "str",
      "description": ""
    },
    "license": {
      "type": "str",
      "description": "DATA_LICENSES.md id (public-domain → Unlicense, unverified → TBD-confirm)"
    },
    "upstream_license": {
      "type": "str",
      "description": ""
    },
    "provenance_source": {
      "type": "str",
      "description": ""
    },
    "url": {
      "type": "str",
      "description": "raw URL of model.inp at the pinned commit"
    },
    "upstream_commit": {
      "type": "str",
      "description": "HydroCouple commit the row was built from"
    },
    "path": {
      "type": "str",
      "description": ""
    },
    "status": {
      "type": "str",
      "description": "census outcome on EPA SWMM 5.2.4: ran, input_error, engine_error, timeout, harness_error"
    },
    "runtime_s": {
      "type": "float64",
      "description": "wall-clock seconds on one core (census)"
    },
    "error_codes": {
      "type": "str",
      "description": "SWMM ERROR codes found in the report"
    },
    "continuity_runoff_pct": {
      "type": "float64",
      "description": "SWMM runoff continuity error, %"
    },
    "continuity_routing_pct": {
      "type": "float64",
      "description": "SWMM flow-routing continuity error, %"
    },
    "engine_version": {
      "type": "str",
      "description": ""
    },
    "continuity_ok": {
      "type": "bool",
      "description": "|continuity| ≤ 5 % (tier eligibility)"
    },
    "tier": {
      "type": "str",
      "description": "tier_pr, tier_nightly, tier_release or none"
    }
  }
}
{
  "schema_version": "1.1.0",
  "case_version": "0.1.0",
  "status": "draft",
  "track": "A",
  "test_id": "A2L-010_idealised_city_dambreak",
  "test_class": "validation_lab",
  "title": "Idealised city dam-break",
  "description": "Dam-break flow through an idealised urban district (Soares-Frazão & Zech 2008).",
  "physics": {
    "dimensionality": "2D",
    "flow_type": "free_surface",
    "governing_equations": [
      "shallow_water_2d"
    ],
    "phenomena": [
      "dam_break",
      "urban",
      "wet_dry"
    ]
  },
  "provenance": {
    "citations": [
      {
        "authors": [
          "Soares-Frazão, S.",
          "Zech, Y."
        ],
        "year": 2008,
        "title": "Dam-break flow through an idealised city",
        "doi": "10.3826/jhr.2008.3164"
      }
    ],
    "license": "TBD-confirm",
    "adaptation_notes": "CADAM/IMPACT laboratory data blocked pending license confirmation."
  },
  "inputs": [
    {
      "path": "inputs/bathymetry.tif",
      "role": "terrain",
      "format": "tif",
      "pending": {
        "reason": "UCLouvain idealised-city flume geometry (Soares-Frazão & Zech 2008); terms not confirmed.",
        "obtain_from": "Université catholique de Louvain (Soares-Frazão)"
      }
    }
  ],
  "reference": {
    "kind": "measured",
    "data_path": "reference/measurements.parquet",
    "uncertainty": {
      "type": "relative",
      "value": 0.05,
      "units": "1",
      "notes": "Draft placeholder uncertainty; replace with published gauge error."
    },
    "include_measurement_uncertainty": true,
    "availability": "pending_license"
  },
  "simulation": {
    "t_end": 30.0,
    "output_interval": 0.5,
    "required_outputs": [
      "h",
      "u",
      "v"
    ]
  },
  "scoring": {
    "criteria": [
      {
        "id": "gauge_NSE",
        "metric": "NSE",
        "variable": "h",
        "threshold": {
          "op": ">=",
          "value": 0.6,
          "units": "1"
        },
        "gating": true,
        "rationale": "NSE vs laboratory gauges ≥ 0.6 within measurement uncertainty."
      },
      {
        "id": "front",
        "metric": "front_position_error",
        "variable": "h",
        "threshold": {
          "op": "abs<=",
          "value": 0.1,
          "units": "m"
        },
        "gating": true,
        "rationale": "Wet/dry front position within 0.1 m of lab imagery / gauges."
      }
    ],
    "pass_rule": "all_gating"
  }
}

  "scoring": {
    "pass_rule": "all_gating",
    "criteria": [
      {
        "id": "final_level_p1",
        "metric": "expected_state_error",
        "against": "pond_final_level_p1",
        "variable": "h",
        "where": "P1",
        "threshold": {
          "op": "abs<=",
          "value": 0.02,
          "units": "m"
        },
        "gating": true,
        "rationale": "A solver that conserves mass and handles the sill must leave the pond at the crest level; 2 cm allows for slow drainage over the sill by t = 20 h."
      },
      {
        "id": "final_level_p2",
        "metric": "expected_state_error",
        "against": "pond_final_level_p2",
        "variable": "h",
        "where": "P2",
        "threshold": {
          "op": "abs<=",
          "value": 0.02,
          "units": "m"
        },
        "gating": true,
        "rationale": "As P1."
      },
      {
        "id": "peak_level",
        "metric": "expected_state_error",
        "against": "peak_level",
        "variable": "h",
        "where": "P1,P2",
        "threshold": {
          "op": "abs<=",
          "value": 0.02,
          "units": "m"
        },
        "gating": true,
        "rationale": "Hydrostatic plateau level during the 10 h hold."
      },
      {
        "id": "final_volume",
        "metric": "expected_state_error",
        "against": "final_stored_volume",
        "variable": "volume",
        "threshold": {
          "op": "abs<=",
          "value": 2.0,
          "units": "%"
        },
        "gating": false,
        "rationale": "Informational: depends on how the solver samples the 2 m DEM onto its own grid."
      }
    ]
  }

        "variable": "h+z",
        "where": "P1",
        "time": 72000,
        "value": 10.25,
        "units": "m",
        "derivation": "Specification §2: after the boundary falls the pond becomes horizontal at the sill elevation, 10.25 m (sill crest at x = 300 m in the DEM)."
      },
      {
        "id": "pond_final_level_p2",
        "variable": "h+z",
        "where": "P2",
        "time": 72000,
        "value": 10.25,
        "units": "m",
        "derivation": "As P1; both points lie in the same pond."
      },
      {
        "id": "peak_level",
        "variable": "h+z",
        "where": "P1,P2",
        "value": 10.35,
        "units": "m",
        "derivation": "Boundary holds 10.35 m for 10 h (60–660 min), long enough for the whole domain to become horizontal (specification §2)."
      },
      {
        "id": "final_stored_volume",
        "variable": "volume",
        "time": 72000,
        "value": 9954.1,
        "units": "m3",
        "derivation": "Pond below 10.25 m (9887.3 m³) plus water below 9.7 m elsewhere (66.9 m³), integrated on the 2 m EA DEM. Solvers on a 10 m grid sample the DEM differently, so this check does not gate."
      }

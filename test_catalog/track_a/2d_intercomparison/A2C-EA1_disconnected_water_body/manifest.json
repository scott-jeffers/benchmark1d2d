    "t_end": 72000.0,
    "output_interval": 60.0,
    "required_outputs": [
      "h",
      "u",
      "v"
    ],
    "probes": [
      {
        "id": "P1",
        "x": 400.0,
        "y": 50.0,
        "variables": [
          "h",
          "u",
          "v"
        ]
      },

{
  "schema_version": "1.1.0",
  "case_version": "1.0.0",
  "status": "candidate",
  "track": "A",
  "test_id": "A1P-030_advection_dispersion_tracer",
  "test_class": "verification_analytic",
  "title": "Advection–dispersion tracer (Ogata–Banks)",
  "description": "A tracer is released continuously at x = 0 into a uniform flow (u = 0.1 m/s, D = 0.01 m²/s); after one hour the front is 360 m downstream. Ogata & Banks (1961) give the exact profile, which tests both advection and dispersion and penalises numerical diffusion.",
  "physics": {
    "dimensionality": "1D",
    "flow_type": "pressurized",
    "governing_equations": [
      "advection_dispersion"
    ],
    "phenomena": [
      "tracer_transport",
      "dispersion"
    ]
  },
  "provenance": {
    "citations": [
      {
        "authors": [
          "Ogata, A.",
          "Banks, R. B."
        ],
        "year": 1961,
        "title": "A Solution of the Differential Equation of Longitudinal Dispersion in Porous Media",
        "report_number": "USGS Professional Paper 411-A"
      }
    ],
    "license": "analytic-public"
  },
  "inputs": [
    {
      "path": "inputs/params.json",
      "role": "case_parameters",
      "format": "json",
      "sha256": "94ed2381312349f7e35df843a0c6c4926d529895c8f8ada75798895570564025"
    }
  ],
  "reference": {
    "kind": "analytic",
    "generator": {
      "module": "references.ogata_banks",
      "function": "concentration",
      "parameters": {
        "u": 0.1,
        "D": 0.01,
        "c0": 1.0
      }
    }
  },
  "simulation": {
    "t_end": 3600.0,
    "output_interval": 60.0,
    "required_outputs": [
      "c",
      "u"
    ],
    "mesh_refinement": {
      "levels": [
        4.0,
        2.0,
        1.0,
        0.5
      ],
      "fixed_courant": 0.5
    }
  },
  "scoring": {
    "criteria": [
      {
        "id": "concentration_L1",
        "metric": "L1",
        "variable": "c",
        "threshold": {
          "op": "abs<=",
          "value": 2.0,
          "units": "%"
        },
        "gating": true,
        "rationale": "Concentration L1 error within 2 % of the L1 norm of the Ogata–Banks profile on the finest grid. The front is 8.5 m wide (2√(Dt)) and moves 360 m, so a scheme with numerical diffusion comparable to D (first-order upwind at u·dx/2 = 0.025 m²/s, 2.5×D) visibly smears it and fails."
      },
      {
        "id": "mass",
        "metric": "global_mass_error",
        "variable": "c",
        "threshold": {
          "op": "abs<=",
          "value": 0.5,
          "units": "%"
        },
        "gating": true,
        "rationale": "Tracer mass in the domain within 0.5 % of the exact integral: a conservative scheme meets it to quadrature error."
      }
    ],
    "convergence": {
      "norm": "L1",
      "variable": "c",
      "expected_order": 2.0,
      "min_observed_order": 1.6
    },
    "pass_rule": "all_gating"
  }
}

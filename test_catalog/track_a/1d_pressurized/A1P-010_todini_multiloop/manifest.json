{
  "schema_version": "1.1.0",
  "case_version": "0.1.0",
  "status": "draft",
  "track": "A",
  "test_id": "A1P-010_todini_multiloop",
  "test_class": "verification_analytic",
  "title": "Todini multi-loop network",
  "description": "Steady two-loop gravity network (Alperovits & Shamir 1977 topology, fixed analysis diameters, Hazen–Williams). Reference heads and flows from a Todini–Pilati gradient solve converged to 1e-12 m, cross-checked against EPANET 2.2 (|ΔH| < 1 mm).",
  "physics": {
    "dimensionality": "1D",
    "flow_type": "pressurized",
    "governing_equations": [
      "darcy_weisbach",
      "network_continuity"
    ],
    "phenomena": [
      "looped_network",
      "steady_hydraulics"
    ]
  },
  "provenance": {
    "citations": [
      {
        "authors": [
          "Todini, E.",
          "Pilati, S."
        ],
        "year": 1988,
        "title": "A gradient algorithm for the analysis of pipe networks",
        "isbn": "9780863800948"
      },
      {
        "authors": [
          "Alperovits, E.",
          "Shamir, U."
        ],
        "year": 1977,
        "title": "Design of optimal water distribution systems",
        "doi": "10.1029/WR013i006p00885"
      }
    ],
    "license": "analytic-public"
  },
  "inputs": [
    {
      "path": "inputs/network.json",
      "role": "network",
      "format": "json",
      "sha256": "e93cd1cba8d75846db32789065c81026c11b0b3334f307fa3342a42d552410f8"
    }
  ],
  "reference": {
    "kind": "analytic",
    "generator": {
      "module": "references.todini",
      "function": "steady_network",
      "parameters": {
        "network_path": "inputs/network.json",
        "demand_scale": 1.0
      }
    }
  },
  "simulation": {
    "t_end": 1.0,
    "output_interval": 1.0,
    "required_outputs": [
      "p",
      "Q"
    ],
    "mesh_refinement": {
      "levels": [
        20.0,
        10.0,
        5.0,
        2.5
      ],
      "fixed_courant": 0.5
    }
  },
  "scoring": {
    "criteria": [
      {
        "id": "nodal_head",
        "metric": "L2",
        "variable": "p",
        "threshold": {
          "op": "abs<=",
          "value": 0.5,
          "units": "%"
        },
        "gating": true,
        "rationale": "Nodal heads within 0.5% of Todini–Pilati reference."
      },
      {
        "id": "link_flow",
        "metric": "L2",
        "variable": "Q",
        "threshold": {
          "op": "abs<=",
          "value": 1.0,
          "units": "%"
        },
        "gating": true,
        "rationale": "Link flows within 1% of reference balance."
      }
    ],
    "convergence": {
      "norm": "L1",
      "variable": "p",
      "expected_order": 1.0,
      "min_observed_order": 0.8
    },
    "pass_rule": "all_gating"
  }
}

    "mesh_refinement": {
      "levels": [
        2.0,
        1.0,
        0.5,
        0.25
      ],
      "fixed_courant": 0.5
    }
  },
  "scoring": {
    "criteria": [
      {
        "id": "depth_L1",
        "metric": "L1",
        "variable": "h",
        "threshold": {
          "op": "abs<=",
          "value": 0.05,
          "units": "m"
        },
        "gating": true,
        "rationale": "L1 depth within 0.05 m of the piecewise-constant Ippen oblique-jump field."
      },
      {
        "id": "mass",
        "metric": "global_mass_error",
        "variable": "volume",
        "threshold": {
          "op": "abs<=",
          "value": 0.1,
          "units": "%"
        },
        "gating": true,
        "rationale": "Mass conservation within 0.1% versus analytic field."
      }
    ],
    "convergence": {
      "norm": "L1",
      "variable": "h",
      "expected_order": 1.0,
      "min_observed_order": 0.8
    },
    "pass_rule": "all_gating"

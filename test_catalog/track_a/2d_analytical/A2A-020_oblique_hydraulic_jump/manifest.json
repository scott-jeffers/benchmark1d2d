{
  "schema_version": "1.0.0",
  "case_version": "0.1.0",
  "status": "draft",
  "track": "A",
  "test_id": "A2A-020_oblique_hydraulic_jump",
  "test_class": "verification_analytic",
  "title": "Oblique hydraulic jump",
  "description": "Supercritical 2D shallow-water flow past a wall deflection producing an oblique hydraulic jump with analytic shock angle (Ippen).",
  "physics": {
    "dimensionality": "2D",
    "flow_type": "free_surface",
    "governing_equations": [
      "shallow_water_2d"
    ],
    "phenomena": [
      "oblique_jump",
      "supercritical",
      "shock"
    ]
  },
  "provenance": {
    "citations": [
      {
        "authors": [
          "Ippen, A. T."
        ],
        "year": 1951,
        "title": "Mechanics of supercritical flow",
        "report_number": "ASCE Trans. 116:268-295"
      }
    ],
    "license": "analytic-public"
  },
  "inputs": [
    {
      "path": "inputs/params.json",
      "role": "parameters",
      "format": "json",
      "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    }
  ],
  "reference": {
    "kind": "analytic",
    "generator": {
      "module": "references.oblique_jump",
      "function": "shock_angle",
      "parameters": {
        "Fr": 2.0,
        "theta": 15.0
      }
    }
  },
  "simulation": {
    "t_end": 50.0,
    "output_interval": 2.0,
    "required_outputs": [
      "h",
      "u",
      "v"
    ],
    "mesh_refinement": {
      "levels": [
        20.0,
        10.0,
        5.0,
        2.5
      ],
      "fixed_courant": 0.5
    }
  },
  "scoring": {
    "criteria": [
      {
        "id": "shock_angle",
        "metric": "front_position_error",
        "variable": "h",
        "threshold": {
          "op": "abs<=",
          "value": 2.0,
          "units": "deg"
        },
        "gating": true,
        "rationale": "Oblique shock angle within 2\u00b0 of Ippen relation."
      },
      {
        "id": "mass",
        "metric": "global_mass_error",
        "variable": "volume",
        "threshold": {
          "op": "abs<=",
          "value": 0.1,
          "units": "%"
        },
        "gating": true,
        "rationale": "Mass conservation within 0.1%."
      }
    ],
    "convergence": {
      "norm": "L1",
      "variable": "h",
      "expected_order": 1.0,
      "min_observed_order": 0.8
    },
    "pass_rule": "all_gating"
  }
}

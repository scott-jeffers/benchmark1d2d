{
  "schema_version": "1.0.0",
  "case_version": "2.0.0",
  "status": "candidate",
  "track": "A",
  "test_id": "A2A-020_oblique_hydraulic_jump",
  "test_class": "verification_analytic",
  "title": "Oblique hydraulic jump",
  "description": "Supercritical flow (Fr₁ = 2.5) meets a straight wall at 15° and is turned through an oblique hydraulic jump. The exact solution has two uniform states separated by a straight jump at 39.58° to the incoming flow, with depth ratio 1.81. It tests shock capturing in 2D and directional accuracy on a Cartesian grid.",
  "physics": {
    "dimensionality": "2D",
    "flow_type": "free_surface",
    "governing_equations": [
      "shallow_water_2d"
    ],
    "phenomena": [
      "oblique_jump",
      "supercritical",
      "shock"
    ]
  },
  "provenance": {
    "citations": [
      {
        "authors": [
          "Ippen, A. T."
        ],
        "year": 1951,
        "title": "Mechanics of supercritical flow",
        "report_number": "ASCE Trans. 116:268-295"
      }
    ],
    "license": "analytic-public"
  },
  "inputs": [
    {
      "path": "inputs/params.json",
      "role": "parameters",
      "format": "json",
      "sha256": "371f5f6bef6c7b1c2b017930dac620783ddedfd687b90519df82dbc6a20ac221"
    }
  ],
  "reference": {
    "kind": "analytic",
    "generator": {
      "module": "references.oblique_jump",
      "function": "depth_velocity",
      "parameters": {
        "Fr1": 2.5,
        "theta_deg": 15.0,
        "h1": 1.0,
        "g": 9.81
      }
    }
  },
  "simulation": {
    "t_end": 50.0,
    "output_interval": 2.0,
    "required_outputs": [
      "h",
      "u",
      "v"
    ],
    "mesh_refinement": {
      "levels": [
        2.0,
        1.0,
        0.5,
        0.25
      ],
      "fixed_courant": 0.45
    }
  },
  "scoring": {
    "criteria": [
      {
        "id": "depth_L1",
        "metric": "L1",
        "variable": "h",
        "threshold": {
          "op": "abs<=",
          "value": 0.05,
          "units": "m"
        },
        "gating": true,
        "rationale": "Mean depth error within 5 cm of the exact two-state field on the finest grid (6 % of the 0.81 m depth jump); a jump at the wrong angle or with the wrong conjugate depth fails."
      },
      {
        "id": "mass",
        "metric": "global_mass_error",
        "variable": "volume",
        "threshold": {
          "op": "abs<=",
          "value": 0.1,
          "units": "%"
        },
        "gating": true,
        "rationale": "Stored volume within 0.1 % of the exact field: the jump sits where the jump conditions put it."
      }
    ],
    "convergence": {
      "norm": "L1",
      "variable": "h",
      "expected_order": 1.0,
      "min_observed_order": 0.8
    },
    "pass_rule": "all_gating"
  }
}

  "title": "Oblique hydraulic jump",
  "description": "Supercritical 2D shallow-water flow past a wall deflection producing an oblique hydraulic jump with analytic shock angle and conjugate states (Ippen).",
  "physics": {
    "dimensionality": "2D",
    "flow_type": "free_surface",
    "governing_equations": [
      "shallow_water_2d"
    ],
    "phenomena": [
      "oblique_jump",
      "supercritical",
      "shock"
    ]
  },
  "provenance": {
    "citations": [
      {
        "authors": [
          "Ippen, A. T."
        ],
        "year": 1951,
        "title": "Mechanics of supercritical flow",
        "report_number": "ASCE Trans. 116:268-295"
      }
    ],
    "license": "analytic-public"
  },
  "inputs": [
    {
      "path": "inputs/params.json",
      "role": "parameters",
      "format": "json",
      "sha256": "fb6fea16b6a81d74448c43a9e1985c0184bd8e649810b5d399646a5663b83e3e"
    }
  ],
  "reference": {
    "kind": "analytic",
    "generator": {
      "module": "references.oblique_jump",
      "function": "depth_velocity",
      "parameters": {
        "Fr1": 2.5,
        "theta_deg": 15.0,
        "h1": 1.0,
        "g": 9.81
      }
    }
  },
  "simulation": {
    "t_end": 50.0,
    "output_interval": 2.0,
    "required_outputs": [
      "h",
      "u",
      "v"

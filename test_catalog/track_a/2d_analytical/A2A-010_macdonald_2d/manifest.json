{
  "schema_version": "1.0.0",
  "case_version": "2.0.0",
  "status": "candidate",
  "track": "A",
  "test_id": "A2A-010_macdonald_2d",
  "test_class": "verification_analytic",
  "title": "MacDonald 2D manufactured channel",
  "description": "Steady subcritical flow with Manning friction in a 1 km × 100 m channel whose bed is built (MacDonald's method) so that a known smooth depth profile is the exact solution. It is A1F-001's profile on a 2D grid: the solver has to balance pressure, bed slope and friction in two dimensions, starting from a uniform depth.",
  "physics": {
    "dimensionality": "2D",
    "flow_type": "free_surface",
    "governing_equations": [
      "shallow_water_2d"
    ],
    "phenomena": [
      "backwater",
      "manufactured",
      "topography"
    ]
  },
  "provenance": {
    "citations": [
      {
        "authors": [
          "MacDonald, I.",
          "Baines, M. J.",
          "Nichols, N. K.",
          "Samuels, P. G."
        ],
        "year": 1997,
        "title": "Analytic benchmark solutions for open-channel flows",
        "doi": "10.1061/(ASCE)0733-9429(1997)123:11(1041)"
      }
    ],
    "license": "analytic-public"
  },
  "inputs": [
    {
      "path": "inputs/params.json",
      "role": "parameters",
      "format": "json",
      "sha256": "71aba8ea945683cf5e16283f05fdd79146ed3feaae6342bc0657d28ed57ae52d"
    }
  ],
  "reference": {
    "kind": "analytic",
    "generator": {
      "module": "references.macdonald_2d",
      "function": "depth_velocity",
      "parameters": {
        "L": 1000.0,
        "W": 100.0,
        "q": 0.2,
        "n_manning": 0.03,
        "g": 9.81
      }
    }
  },
  "simulation": {
    "t_end": 3600.0,
    "output_interval": 3600.0,
    "required_outputs": [
      "h",
      "u",
      "v",
      "z"
    ],
    "mesh_refinement": {
      "levels": [
        50.0,
        25.0,
        12.5,
        6.25
      ],
      "fixed_courant": 0.45
    }
  },
  "scoring": {
    "criteria": [
      {
        "id": "depth_L1",
        "metric": "L1",
        "variable": "h",
        "threshold": {
          "op": "abs<=",
          "value": 0.01,
          "units": "m"
        },
        "gating": true,
        "rationale": "Mean depth error below 1 cm on the finest grid (1.3 % of the 0.74 m outlet depth); a scheme that is not well balanced over the sloping bed, or that mis-applies friction, settles to a visibly different profile."
      },
      {
        "id": "mass",
        "metric": "global_mass_error",
        "variable": "volume",
        "threshold": {
          "op": "abs<=",
          "value": 0.5,
          "units": "%"
        },
        "gating": true,
        "rationale": "Water stored in the channel within 0.5 % of the exact profile: confirms the run has reached the steady state rather than a different equilibrium."
      }
    ],
    "convergence": {
      "norm": "L1",
      "variable": "h",
      "expected_order": 1.0,
      "min_observed_order": 0.8
    },
    "pass_rule": "all_gating"
  }
}

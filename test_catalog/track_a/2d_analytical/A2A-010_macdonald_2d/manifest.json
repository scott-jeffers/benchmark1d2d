{
  "schema_version": "1.0.0",
  "case_version": "0.1.0",
  "status": "draft",
  "track": "A",
  "test_id": "A2A-010_macdonald_2d",
  "test_class": "verification_analytic",
  "title": "MacDonald 2D analytic channel",
  "description": "2D extension of the MacDonald open-channel analytic benchmark for steady free-surface flow with friction and topography.",
  "physics": {
    "dimensionality": "2D",
    "flow_type": "free_surface",
    "governing_equations": [
      "shallow_water_2d"
    ],
    "phenomena": [
      "backwater",
      "friction",
      "topography"
    ]
  },
  "provenance": {
    "citations": [
      {
        "authors": [
          "MacDonald, I.",
          "Baines, M. J.",
          "Nichols, N. K.",
          "Samuels, P. G."
        ],
        "year": 1997,
        "title": "Analytic benchmark solutions for open-channel flows",
        "doi": "10.1061/(ASCE)0733-9429(1997)123:11(1041)"
      }
    ],
    "license": "analytic-public"
  },
  "inputs": [
    {
      "path": "inputs/params.json",
      "role": "parameters",
      "format": "json",
      "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    }
  ],
  "reference": {
    "kind": "analytic",
    "generator": {
      "module": "references.macdonald",
      "function": "depth_2d",
      "parameters": {
        "q": 2.0,
        "g": 9.81
      }
    }
  },
  "simulation": {
    "t_end": 1000.0,
    "output_interval": 50.0,
    "required_outputs": [
      "h",
      "u",
      "v"
    ],
    "mesh_refinement": {
      "levels": [
        20.0,
        10.0,
        5.0,
        2.5
      ],
      "fixed_courant": 0.5
    }
  },
  "scoring": {
    "criteria": [
      {
        "id": "depth_L1",
        "metric": "L1",
        "variable": "h",
        "threshold": {
          "op": "abs<=",
          "value": 1.0,
          "units": "%"
        },
        "gating": true,
        "rationale": "L1 depth within 1% of MacDonald analytic profile."
      },
      {
        "id": "mass",
        "metric": "global_mass_error",
        "variable": "volume",
        "threshold": {
          "op": "abs<=",
          "value": 0.1,
          "units": "%"
        },
        "gating": true,
        "rationale": "Volume conservation within 0.1%."
      }
    ],
    "convergence": {
      "norm": "L1",
      "variable": "h",
      "expected_order": 1.0,
      "min_observed_order": 0.8
    },
    "pass_rule": "all_gating"
  }
}

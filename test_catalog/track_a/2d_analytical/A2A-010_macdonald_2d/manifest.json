{
  "schema_version": "1.0.0",
  "case_version": "0.1.0",
  "status": "candidate",
  "track": "A",
  "test_id": "A2A-010_macdonald_2d",
  "test_class": "verification_analytic",
  "title": "MacDonald 2D manufactured channel",
  "description": "2D manufactured steady free-surface depth over a known bed (MacDonald-style), with mild spanwise modulation, for shallow-water verification.",
  "physics": {
    "dimensionality": "2D",
    "flow_type": "free_surface",
    "governing_equations": [
      "shallow_water_2d"
    ],
    "phenomena": [
      "backwater",
      "manufactured",
      "topography"
    ]
  },
  "provenance": {
    "citations": [
      {
        "authors": [
          "MacDonald, I.",
          "Baines, M. J.",
          "Nichols, N. K.",
          "Samuels, P. G."
        ],
        "year": 1997,
        "title": "Analytic benchmark solutions for open-channel flows",
        "doi": "10.1061/(ASCE)0733-9429(1997)123:11(1041)"
      }
    ],
    "license": "analytic-public"
  },
  "inputs": [
    {
      "path": "inputs/params.json",
      "role": "parameters",
      "format": "json",
      "sha256": "02fd536f9a8d3f0ee6a89b90332c291b7c867b43a76c5445e204e80672b6ac1c"
    }
  ],
  "reference": {
    "kind": "analytic",
    "generator": {
      "module": "references.macdonald_2d",
      "function": "depth_velocity",
      "parameters": {
        "L": 1000.0,
        "W": 100.0,
        "amp": 0.25,
        "k": 16.0,
        "span_amp": 0.05,
        "qx": 0.2,
        "qy": 0.0,
        "g": 9.81
      }
    }
  },
  "simulation": {
    "t_end": 1000.0,
    "output_interval": 50.0,
    "required_outputs": [
      "h",
      "u",
      "v"
    ],
    "mesh_refinement": {
      "levels": [
        40.0,
        20.0,
        10.0,
        5.0
      ],
      "fixed_courant": 0.5
    }
  },
  "scoring": {
    "criteria": [
      {
        "id": "depth_L1",
        "metric": "L1",
        "variable": "h",
        "threshold": {
          "op": "abs<=",
          "value": 0.01,
          "units": "m"
        },
        "gating": true,
        "rationale": "L1 depth within 0.01 m of the manufactured MacDonald-style 2D profile."
      },
      {
        "id": "mass",
        "metric": "global_mass_error",
        "variable": "volume",
        "threshold": {
          "op": "abs<=",
          "value": 0.1,
          "units": "%"
        },
        "gating": true,
        "rationale": "Volume conservation within 0.1% versus analytic field."
      }
    ],
    "convergence": {
      "norm": "L1",
      "variable": "h",
      "expected_order": 1.0,
      "min_observed_order": 0.8
    },
    "pass_rule": "all_gating"
  }
}

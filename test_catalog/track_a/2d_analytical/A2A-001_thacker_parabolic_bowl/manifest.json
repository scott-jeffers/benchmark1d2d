{
  "schema_version": "1.1.0",
  "case_version": "2.0.0",
  "status": "candidate",
  "track": "A",
  "test_id": "A2A-001_thacker_parabolic_bowl",
  "test_class": "verification_analytic",
  "title": "Thacker parabolic bowl",
  "description": "2D shallow-water planar free-surface oscillation in a parabolic bowl (Thacker 1981) with a moving wet/dry shoreline. Reference: zs = (η h0/L²)(2x cos ωt − η cos² ωt), u = −η ω sin ωt, ω = √(2 g h0)/L. Case v2.0.0 replaces a v1 reference that satisfied momentum but violated mass conservation (wrong ω and a missing cos² term).",
  "physics": {
    "dimensionality": "2D",
    "flow_type": "free_surface",
    "governing_equations": [
      "shallow_water_2d"
    ],
    "phenomena": [
      "wet_dry",
      "oscillation",
      "parabolic_bowl"
    ]
  },
  "provenance": {
    "citations": [
      {
        "authors": [
          "Thacker, W. C."
        ],
        "year": 1981,
        "title": "Some exact solutions to the nonlinear shallow-water wave equations",
        "doi": "10.1017/S0022112081001882"
      }
    ],
    "license": "analytic-public"
  },
  "inputs": [
    {
      "path": "inputs/params.json",
      "role": "parameters",
      "format": "json",
      "sha256": "c9abbf61996257072e21811e6efe20aabb3e2ebab6a1d44fb377ef8ef076fc53"
    }
  ],
  "reference": {
    "kind": "analytic",
    "generator": {
      "module": "references.thacker",
      "function": "depth_velocity",
      "parameters": {
        "h0": 0.1,
        "L": 1.0,
        "eta": 0.05,
        "g": 9.81
      }
    }
  },
  "simulation": {
    "t_end": 1.0,
    "output_interval": 0.25,
    "required_outputs": [
      "h",
      "u",
      "v"
    ],
    "mesh_refinement": {
      "levels": [
        0.1,
        0.05,
        0.025,
        0.0125
      ],
      "fixed_courant": 0.5
    }
  },
  "scoring": {
    "criteria": [
      {
        "id": "depth_L1",
        "metric": "L1",
        "variable": "h",
        "threshold": {
          "op": "abs<=",
          "value": 0.02,
          "units": "m"
        },
        "gating": true,
        "rationale": "L1 depth error within 0.02 m of Thacker exact solution on the finest mesh."
      },
      {
        "id": "mass",
        "metric": "global_mass_error",
        "variable": "volume",
        "threshold": {
          "op": "abs<=",
          "value": 0.1,
          "units": "%"
        },
        "gating": true,
        "rationale": "Global volume conserved within 0.1% versus analytic wet mass."
      }
    ],
    "convergence": {
      "norm": "L1",
      "variable": "h",
      "expected_order": 1.0,
      "min_observed_order": 0.8
    },
    "pass_rule": "all_gating"
  }
}

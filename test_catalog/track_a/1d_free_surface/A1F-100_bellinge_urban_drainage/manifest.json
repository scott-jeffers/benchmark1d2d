    "dimensionality": "1D",
    "flow_type": "mixed",
    "governing_equations": [
      "saint_venant_dynamic",
      "rainfall_runoff"
    ],
    "phenomena": [
      "surcharge",
      "pump",
      "combined_sewer_overflow",
      "network_routing"
    ]
  },
  "provenance": {
    "citations": [

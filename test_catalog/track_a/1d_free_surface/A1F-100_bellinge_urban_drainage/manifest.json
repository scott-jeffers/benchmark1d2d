  "scoring": {
    "pass_rule": "all_gating",
    "criteria": [
      {
        "id": "level_nse",
        "metric": "NSE",
        "variable": "wse",
        "aggregate": "median",
        "threshold": {
          "op": ">=",
          "value": 0.5,
          "units": "1"
        },
        "gating": true,
        "rationale": "Set before any run: Moriasi et al. (2007) 'satisfactory' band, NSE ≥ 0.5, for the median gauge record (a meter on one storm). A record where the meter moved less than three times its accuracy is not scored for NSE."
      },
      {
        "id": "peak_level",
        "metric": "peak_error",
        "variable": "wse",
        "aggregate": "median",
        "threshold": {
          "op": "abs<=",
          "value": 0.1,
          "units": "m"
        },
        "gating": true,
        "rationale": "Set before any run: the ±0.1 m depth criterion for verifying sewer models against measurements (WaPUG 2002; CIWEM UDG 2017 Code of Practice), for the median gauge record."
      }
    ]

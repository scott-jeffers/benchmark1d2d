      "module": "references.swashes",
      "function": "steady_bump",
      "parameters": {
        "case": "transcritical",
        "g": 9.81
      }
    }
  },
  "simulation": {
    "t_end": 300.0,
    "output_interval": 300.0,
    "required_outputs": [
      "h",
      "u",
      "Q"
    ],
    "mesh_refinement": {
      "levels": [
        0.2,
        0.1,
        0.05
      ],
      "fixed_courant": 0.5
    },
    "steady": true
  },
  "scoring": {
    "criteria": [
      {
        "id": "L1_h",
        "metric": "L1",
        "variable": "h",
        "threshold": {
          "op": "abs<=",
          "value": 0.005,
          "units": "m"
        },
        "gating": true,
        "rationale": "Average depth error under 5 mm (1 % of the downstream depth) once steady; the critical point at the crest is where schemes struggle."
      },
      {
        "id": "L1_Q",
        "metric": "L1",
        "variable": "Q",
        "threshold": {
          "op": "abs<=",
          "value": 0.0153,
          "units": "m²/s"
        },
        "gating": true,
        "rationale": "Discharge within 1 % of q on average."
      }
    ],
    "convergence": {
      "norm": "L1",
      "variable": "h",
      "expected_order": 1.0,
      "min_observed_order": 0.8
    },
    "pass_rule": "all_gating"
  }

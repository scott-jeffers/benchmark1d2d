  "test_id": "A1F-040_swashes_bump_subcritical",
  "test_class": "verification_analytic",
  "title": "Subcritical flow over a bump (SWASHES)",
  "description": "Steady frictionless flow of q = 4.42 m²/s over a 0.2 m parabolic bump in a 25 m channel, held at 2 m downstream. The flow stays subcritical; the depth follows from constant discharge and Bernoulli head (a cubic at every point), dipping to 1.71 m over the crest.",
  "physics": {
    "dimensionality": "1D",
    "flow_type": "free_surface",
    "governing_equations": [
      "saint_venant_dynamic"
    ],
    "phenomena": [
      "steady_hydraulics",
      "bed_slope"
    ]
  },
  "provenance": {
    "citations": [
      {
        "authors": [
          "Delestre, O.",
          "Lucas, C.",
          "Ksinant, P.-A.",
          "Darboux, F.",
          "Laguerre, C.",
          "Vo, T. N. T.",
          "James, F.",
          "Cordier, S."
        ],
        "year": 2013,
        "title": "SWASHES: a compilation of shallow water analytic solutions for hydraulic and environmental studies",
        "doi": "10.1002/fld.3741"
      },
      {
        "authors": [
          "Goutal, N.",
          "Maurel, F."
        ],
        "year": 1997,
        "title": "Proceedings of the 2nd workshop on dam-break wave simulation (EDF HE-43/97/016/B)",
        "url": "https://www.irit.fr/swashes"
      }
    ],
    "license": "analytic-public"
  },
  "inputs": [
    {
      "path": "inputs/params.json",
